{
  "files.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.expo": true,
    "**/__pycache__": true,
    "**/data": true,
    "**/*.jpg": true,
    "**/*.png": true,
    "**/flutter/dev/**": true,
    "**/flutter/packages/**": true,
    "**/flutter/bin/**": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/data": true,
    "**/flutter/dev/**": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/data/**": true,
    "**/.expo/**": true,
    "**/flutter/**": true
  },
  "python.analysis.exclude": [
    ".venv",
    "node_modules",
    "data"
  ],
  "dart.analysisExcludedFolders": [
    "flutter/dev",
    "flutter/packages",
    "flutter/bin"
  ]
}